generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  brand       String   @default("BC STORE")
  category    String   @default("Camisetas")
  priceCents  Int
  imageUrl    String
  sizes       String   @default("P,M,G,GG")
  colors      String   @default("Preto")
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([category])
}